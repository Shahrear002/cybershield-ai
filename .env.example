# CyberShield AI — Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit the '.env' file to your Git repository!

# ── Spring Boot Backend API Keys (Port 8080) ──────────────────────────────────
# The Spring Boot application automatically resolves these from your .env
# file at startup using spring-dotenv.

# Active LLM Provider Configuration
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_KEY
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_KEY
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY

# ── Nuxt 3 Client Configuration (Port 3000) ───────────────────────────────────
NUXT_PUBLIC_API_BASE=http://localhost:8080
